# DLNN light style. Categorical cycle = dataviz reference slots 1-4 (validated; secondary encoding via markers/linestyles).
figure.facecolor: none
axes.facecolor: none
savefig.facecolor: none
savefig.edgecolor: none
savefig.transparent: True
text.color: 0b0b0b
axes.labelcolor: 0b0b0b
axes.edgecolor: 52514e
xtick.color: 52514e
ytick.color: 52514e
axes.titlecolor: 0b0b0b
axes.grid: True
grid.color: e3e2dc
grid.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
lines.linewidth: 2.0
lines.markersize: 7
legend.frameon: False
legend.labelcolor: 0b0b0b
font.size: 10
axes.titlesize: 11
axes.titleweight: bold
svg.fonttype: none
figure.dpi: 110
savefig.dpi: 160
