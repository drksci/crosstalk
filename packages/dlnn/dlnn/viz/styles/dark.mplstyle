# DLNN dark style. Categorical cycle = dataviz reference slots 1-4 (validated; secondary encoding via markers/linestyles).
figure.facecolor: none
axes.facecolor: none
savefig.facecolor: none
savefig.edgecolor: none
savefig.transparent: True
text.color: f0efec
axes.labelcolor: f0efec
axes.edgecolor: c3c2b7
xtick.color: c3c2b7
ytick.color: c3c2b7
axes.titlecolor: f0efec
axes.grid: True
grid.color: 3a3a37
grid.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
lines.linewidth: 2.0
lines.markersize: 7
legend.frameon: False
legend.labelcolor: f0efec
font.size: 10
axes.titlesize: 11
axes.titleweight: bold
svg.fonttype: none
figure.dpi: 110
savefig.dpi: 160
